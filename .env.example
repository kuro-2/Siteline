# Copy to .env and fill in. Never commit .env.
# Values marked (secret) must never be shared, pasted in chats or committed.

# App
APP_NAME=Siteline
APP_ENV=local
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:8000
CONTACT_EMAIL=                       # sent in the User-Agent to OpenStreetMap services

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=                   # "anon" or new "publishable" key (sb_publishable_…)
SUPABASE_SERVICE_ROLE_KEY=           # (secret) "service_role" or new "secret" key (sb_secret_…)
SUPABASE_JWT_SECRET=                 # (secret) legacy HS256 secret; leave empty if using JWKS
SUPABASE_JWKS_URL=                   # e.g. https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
DATABASE_URL=                        # (secret) pooler connection string with your DB password

# Web (public, safe to expose)
NEXT_PUBLIC_APP_NAME=Siteline
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_DEFAULT_AREA=pilot
NEXT_PUBLIC_PHONE_OTP_ENABLED=false

# Pilot area
PILOT_AREA_SLUG=pilot
PILOT_AREA_NAME=
PILOT_BOUNDARY_PATH=data/pilot_boundary.geojson

# Data
WORLDPOP_RASTER_PATH=                # full path to the .tif, e.g. data/worldpop/ind_ppp_2020_UNadj_constrained.tif
WORLDPOP_YEAR=2020
WARDS_GEOJSON_PATH=
OVERPASS_URL=https://overpass-api.de/api/interpreter
OHSOME_URL=https://api.ohsome.org/v1

# Google Places (paid beyond free tier)
GOOGLE_PLACES_API_KEY=               # (secret)
GOOGLE_MONTHLY_CALL_CAP=4500         # per SKU; Pro SKU has 5,000 free calls/month
GOOGLE_CACHE_DAYS=30
GOOGLE_INGEST_CONFIRMED=false        # must be true for any real (billed) call
GOOGLE_RATINGS_ENABLED=false         # true moves calls to the Enterprise SKU (only 1,000 free/month)
GOOGLE_REVIEWS_ENABLED=false
GOOGLE_REFRESH_ENABLED=false         # lets the monthly GitHub Action call Google

# LLM
LLM_PROVIDER=template                # template | ollama | gemini | groq
GEMINI_API_KEY=                      # (secret)
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=                        # (secret)
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Surveys / field
KOBO_BASE_URL=https://kf.kobotoolbox.org
KOBO_API_TOKEN=                      # (secret)
KOBO_ASSET_UID=
CONSENT_VERSION=2026-11-v1
DEVICE_HASH_SALT=                    # (secret) any long random string; used to hash device ids

# Monitoring (optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
